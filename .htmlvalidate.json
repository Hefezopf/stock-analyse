{
  "elements": ["html5"],

  "extends": ["html-validate:recommended"],

  "rules": {
    "no-trailing-whitespace": "error",
    "no-inline-style": "off",
    "no-dup-id": "off",
    "attr-quotes": "off",
    "attr-case": "warn",
    "no-implicit-close": "error",
    "attr-spacing": "error",
    "void-style": "error"
  }
}